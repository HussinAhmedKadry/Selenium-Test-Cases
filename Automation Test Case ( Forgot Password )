import org.openqa.selenium.By;

import org.openqa.selenium.WebDriver;

import org.openqa.selenium.WebElement;

import org.openqa.selenium.chrome.ChromeDriver;

public class GoogleForgotPassword {

public static void main(String[] args) {

System.setProperty("webdriver.chrome.driver", "path/to/chromedriver");

        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();

        try {
            driver.get("http://accounts.google.com/");

            // Click on "Forgot password?" link
            WebElement forgotPasswordLink = driver.findElement(By.xpath("//button[contains(text(),'Forgot password?')]"));
            forgotPasswordLink.click();
            Thread.sleep(2000); // Wait for the next page to load

            // Enter email or phone number
            WebElement emailField = driver.findElement(By.id("identifierId"));
            emailField.sendKeys("your-email@gmail.com");
            driver.findElement(By.id("identifierNext")).click();
            Thread.sleep(3000); // Wait for recovery options to load

            System.out.println("Forgot Password process initiated successfully.");

        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            driver.quit();
        }
    }
}
